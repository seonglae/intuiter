{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Intuiter",
  "version": "0.9.0",
  "identifier": "com.intuiter.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Intuiter",
        "width": 1000,
        "height": 600,
        "minWidth": 1000,
        "minHeight": 600,
        "transparent": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../asset/icons/white.png",
      "../asset/icons/white.ico"
    ],
    "resources": {
      "../packages/mac-input/hammerspoon": "mac-input/hammerspoon"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
